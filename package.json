{
  "name": "@qfeius/contract-cli",
  "version": "0.3.3-beta.1",
  "description": "CLI for Qfei contract open platform",
  "bin": {
    "contract-cli": "scripts/run.js"
  },
  "scripts": {
    "postinstall": "node scripts/install.js",
    "build": "./build.sh",
    "test": "go test ./..."
  },
  "config": {
    "binaryName": "contract-cli",
    "downloadBaseURLTemplate": "https://github.com/qfeius/contract-cli/releases/download/v{version}"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "engines": {
    "node": ">=16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qfeius/contract-cli.git"
  },
  "publishConfig": {
    "registry": "https://nexus.qtech.cn/repository/npm-hosted/"
  },
  "license": "UNLICENSED",
  "files": [
    "scripts/install.js",
    "scripts/run.js",
    "dist/release-assets/**",
    "skills/**/SKILL.md",
    "skills/**/agents/**",
    "skills/**/references/**",
    "!skills/contract-cli-api-call/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@11.4.0+sha512.f0febc7e37552ab485494a914241b338e0b3580b93d54ce31f00933015880863129038a1b4ae4e414a0ee63ac35bf21197e990172c4a68256450b5636310968f"
}
